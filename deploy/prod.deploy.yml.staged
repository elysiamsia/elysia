# 待启用的生产部署（把内容合并进 .github/workflows/deploy.yml 后生效）
# 2026-10-18 由 Task 11 预置；**未启用**。启用前需主人点头，且已完成 switchover-checklist 的一、四节。
name: 生产部署（构建版）
on:
  push:
    branches: [main]
  workflow_dispatch:
jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: npm install --no-audit --no-fund
      - name: 构建（严格模式：12 页缺模板即失败）
        run: npm run build -- --strict-templates
      - name: 产物自检
        run: |
          set -euo pipefail
          for p in index.html kevin/index.html su/index.html; do
            test -s "public/$p" || { echo "缺产物 $p"; exit 1; }
          done
          echo "文件数 $(find public -type f | wc -l)"
      - name: 上传并原子替换
        env:
          SSH_KEY: ${{ secrets.SSH_KEY }}
          HOST: 1.14.60.153
          USER: ubuntu
        run: |
          set -euo pipefail
          mkdir -p ~/.ssh && printf %s\\n "$SSH_KEY" > ~/.ssh/id_deploy && chmod 600 ~/.ssh/id_deploy
          ssh-keyscan -H "$HOST" >> ~/.ssh/known_hosts 2>/dev/null || true
          tar czf /tmp/site.tgz -C public .
          scp -i ~/.ssh/id_deploy -o StrictHostKeyChecking=accept-new /tmp/site.tgz "$USER@$HOST:/tmp/site.tgz"
          ssh -i ~/.ssh/id_deploy "$USER@$HOST" 'set -e; WEB=/var/www/elysiad; sudo mkdir -p $WEB && sudo chown ubuntu:ubuntu $WEB; sudo rm -rf $WEB.prev && sudo cp -a $WEB $WEB.prev; find $WEB -mindepth 1 -maxdepth 1 -exec rm -rf {} +; tar xzf /tmp/site.tgz -C $WEB; rm -f /tmp/site.tgz; echo 已发布 $(find $WEB -type f | wc -l) 个文件'
