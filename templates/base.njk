<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<!-- 呀！标签页上也要有一枚小花呀，不然浏览器给的是个空白方块呢♥ -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<!-- 呀！分享出去的时候，要带着她的样子，而不是一行光秃秃的链接♥ -->
<meta name="description" content="{{ meta.description }}">
{% if meta.noindex %}<meta name="robots" content="noindex">
{% endif %}{% if meta.canonical %}<link rel="canonical" href="{{ meta.canonical }}">
{% endif %}{% if meta.canonical %}<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "{{ meta.title }}",
  "url": "{{ meta.canonical }}",
  "description": "{{ meta.description }}",
  "inLanguage": "zh-CN",
  "isPartOf": {
    "@type": "WebSite",
    "name": "elysiad.top — 致爱莉希雅",
    "url": "https://elysiad.top/"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "首页",
      "item": "https://elysiad.top/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ character.shortName }}",
      "item": "{{ meta.canonical }}"
    }
  ]
}
</script>
{% endif %}<meta property="og:type" content="website">
<meta property="og:site_name" content="elysiad.top">
<meta property="og:title" content="{{ meta.ogTitle or ('致' + character.shortName + ' — elysiad.top') }}">
<meta property="og:description" content="{{ meta.ogDescription }}">
{% if meta.canonical %}<meta property="og:url" content="{{ meta.canonical }}">
{% endif %}<meta property="og:image" content="{{ meta.ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
{{ themeColorTag | safe }}<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% if not meta.standalone %}<!-- 呀！8 个页面共用的那一层，终于收进一个文件里啦♥ -->
<link rel="stylesheet" href="/assets/site.css">
<link rel="stylesheet" href="/assets/explore.css">
{% endif %}<meta name="referrer" content="same-origin">
<!-- 11.11 预热条（2026）：页脚上方那一朵朵点亮的花环 + 今天那句。别的时候脚本自己什么都不建。 -->
<link rel="stylesheet" href="/assets/preheat.css">
<!-- 11.11 当天换装（2026）：assets/bday-theme.js 只在 11-11 挂上 data-bday，样式见这份 CSS。 -->
<link rel="stylesheet" href="/assets/bday-theme.css">
<title>{{ meta.title }}</title>

<!-- SECTION: styles -->
{{ stylesHtml | safe }}
</head>
<body{{ bodyAttrs | safe }}>{{ pageBody | safe }}<footer class="site-legal">
  <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">粤ICP备2026047652号</a>
</footer>
<script src="/data/preheat.js" defer></script>
<script src="/assets/preheat.js" defer></script>
<script src="/assets/bday-theme.js" defer></script>
</body>
</html>
