<!-- 呀！8 个页面共用的那一层，终于收进一个文件里啦♥ -->
<link rel="stylesheet" href="/assets/site.css">
<!-- 生日倒计时胶囊的样式住在共享层（2026-10-01 起）。
     ⚠ **必须在页面 <style> 之前** —— 页面自己的规则要能覆盖共享层，
       这是全站一致的加载顺序（spec §3.2）。
     ⚠ 这一页的 :root **不定义 --bday-\***：让它吃默认值，
       而默认值就是从这一页原来写死的那套粉紫抄下来的 → **逐像素不变**。 -->
<link rel="stylesheet" href="/assets/explore.css">
<!-- 11.11 预热条（2026）：与英桀页同一条，样式/脚本都是共享的那一份。 -->
<link rel="stylesheet" href="/assets/preheat.css">
<!-- 11.11 当天换装（2026）：与英桀页同一份，靠 assets/bday-theme.js 挂 data-bday。 -->
<link rel="stylesheet" href="/assets/bday-theme.css">
<title>elysiad.top — 致爱莉希雅</title>
{{ stylesHtml | safe }}
</head>
<body>
{{ pageBody | safe }}
</body>
<!-- ===== 生日倒计时彩蛋 =====
     ⚠ 2026-10-01 起它是**共享组件**（assets/bday.js），不再是这一页自己的一份 ——
       别的英桀页用的是**同一个**。「形式一样」最硬的保证，就是「本来就是同一个组件」。
       （只给英桀页写一份、首页留着内联那份的话，站上就有两份同一个界面，
         正是项目最忌的「同一件事两处维护」。）
     ⚠ 月份日期也从**写死的 10/11** 改成读 data/bdays.js（全站唯一数据源）。 -->
<script src="/data/bdays.js"></script>
<script src="/assets/bday.js"></script>
<script>
ElysiaBday.mount({
  // ⚠ 这两句**逐字**保持原来内联那版的内容，一个字没动。
  //    首页**不传** `src`：它原来就没有出处标注，传了会凭空多出一个节点。
  msg: '「今天是我的生日哦。要一起庆祝吗？<br>就我们两个人。」',
  birthMsg: '「嗨，想我了吗？」<br>今天是属于爱莉希雅的日子——<br><span class="pink">愿每一份祝福，都如飞花般绚丽♪</span>',
});
</script>
<script src="/data/preheat.js" defer></script>
<script src="/assets/preheat.js" defer></script>
<script src="/assets/bday-theme.js" defer></script>

</html>
